Windows Registry Editor Version 5.00

; Win10 推荐：双击导入前请把 YOUR_USERNAME 改成你的 Windows 用户名
; 导入后若菜单未出现，请注销或重启资源管理器

; 在文件夹空白处右键（需管理员权限导入到 HKCR）
[HKEY_CLASSES_ROOT\Directory\Background\shell\OpenWithCursor]
@="用 Cursor 打开"
"Icon"="C:\\Users\\YOUR_USERNAME\\AppData\\Local\\Programs\\cursor\\Cursor.exe,0"

[HKEY_CLASSES_ROOT\Directory\Background\shell\OpenWithCursor\command]
@="\"C:\\Users\\YOUR_USERNAME\\AppData\\Local\\Programs\\cursor\\Cursor.exe\" \"%V\""
